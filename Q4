#include <stdio.h>
#include <stdlib.h>

#define MAX 100

void sort(int arr[], int n)
{
    int i, j, temp;

    for (i = 0; i < n - 1; i++)
    {
        for (j = i + 1; j < n; j++)
        {
            if (arr[i] > arr[j])
            {
                temp = arr[i];
                arr[i] = arr[j];
                arr[j] = temp;
            }
        }
    }
}

void cscan(int queue[], int n, int head, int diskSize, char direction)
{
    int arr[MAX];
    int i, current = head;
    int movement = 0;

    for (i = 0; i < n; i++)
        arr[i] = queue[i];

    sort(arr, n);

    printf("\nC-SCAN Seek Sequence:\n");
    printf("%d ", head);

    if (direction == 'R' || direction == 'r')
    {
        /* Service requests to the right */
        for (i = 0; i < n; i++)
        {
            if (arr[i] >= head)
            {
                movement += abs(current - arr[i]);
                current = arr[i];
                printf("-> %d ", current);
            }
        }

        /* Move to end */
        if (current != diskSize - 1)
        {
            movement += abs(current - (diskSize - 1));
            current = diskSize - 1;
            printf("-> %d ", current);
        }

        /* Jump to beginning */
        movement += diskSize - 1;
        current = 0;
        printf("-> %d ", current);

        /* Service remaining requests */
        for (i = 0; i < n; i++)
        {
            if (arr[i] < head)
            {
                movement += abs(current - arr[i]);
                current = arr[i];
                printf("-> %d ", current);
            }
        }
    }
    else
    {
        /* Service requests to the left */
        for (i = n - 1; i >= 0; i--)
        {
            if (arr[i] <= head)
            {
                movement += abs(current - arr[i]);
                current = arr[i];
                printf("-> %d ", current);
            }
        }

        /* Move to beginning */
        if (current != 0)
        {
            movement += current;
            current = 0;
            printf("-> %d ", current);
        }

        /* Jump to end */
        movement += diskSize - 1;
        current = diskSize - 1;
        printf("-> %d ", current);

        /* Service remaining requests */
        for (i = n - 1; i >= 0; i--)
        {
            if (arr[i] > head)
            {
                movement += abs(current - arr[i]);
                current = arr[i];
                printf("-> %d ", current);
            }
        }
    }

    printf("\nTotal Head Movement = %d\n", movement);
}

void look(int queue[], int n, int head, char direction)
{
    int arr[MAX];
    int i, current = head;
    int movement = 0;

    for (i = 0; i < n; i++)
        arr[i] = queue[i];

    sort(arr, n);

    printf("\nLOOK Seek Sequence:\n");
    printf("%d ", head);

    if (direction == 'R' || direction == 'r')
    {
        /* Move right */
        for (i = 0; i < n; i++)
        {
            if (arr[i] >= head)
            {
                movement += abs(current - arr[i]);
                current = arr[i];
                printf("-> %d ", current);
            }
        }

        /* Reverse without going to disk end */
        for (i = n - 1; i >= 0; i--)
        {
            if (arr[i] < head)
            {
                movement += abs(current - arr[i]);
                current = arr[i];
                printf("-> %d ", current);
            }
        }
    }
    else
    {
        /* Move left */
        for (i = n - 1; i >= 0; i--)
        {
            if (arr[i] <= head)
            {
                movement += abs(current - arr[i]);
                current = arr[i];
                printf("-> %d ", current);
            }
        }

        /* Reverse */
        for (i = 0; i < n; i++)
        {
            if (arr[i] > head)
            {
                movement += abs(current - arr[i]);
                current = arr[i];
                printf("-> %d ", current);
            }
        }
    }

    printf("\nTotal Head Movement = %d\n", movement);
}

int main()
{
    int queue[MAX];
    int n, head, diskSize;
    char direction;
    int i;

    printf("Enter disk size: ");
    scanf("%d", &diskSize);

    printf("Enter number of requests: ");
    scanf("%d", &n);

    printf("Enter request queue:\n");

    for (i = 0; i < n; i++)
        scanf("%d", &queue[i]);

    printf("Enter initial head position: ");
    scanf("%d", &head);

    printf("Enter direction (L for Left, R for Right): ");
    scanf(" %c", &direction);

    cscan(queue, n, head, diskSize, direction);
    look(queue, n, head, direction);

    printf("\nConclusion:\n");
    printf("LOOK usually provides lower head movement because it does not\n");
    printf("travel to the physical end of the disk when no request exists there.\n");

    return 0;
}

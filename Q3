```c
#include <stdio.h>
#include <stdlib.h>

#define MAX 100

void fcfs(int queue[], int n, int head)
{
    int i, movement = 0, current = head;

    printf("\nFCFS Seek Sequence:\n");
    printf("%d ", head);

    for (i = 0; i < n; i++)
    {
        movement += abs(current - queue[i]);
        current = queue[i];
        printf("-> %d ", current);
    }

    printf("\nTotal Seek Time = %d\n", movement);
}

void sstf(int queue[], int n, int head)
{
    int visited[MAX] = {0};
    int i, count, index;
    int movement = 0, current = head;
    int distance, minDistance;

    printf("\nSSTF Seek Sequence:\n");
    printf("%d ", head);

    for (count = 0; count < n; count++)
    {
        minDistance = 999999;
        index = -1;

        for (i = 0; i < n; i++)
        {
            if (!visited[i])
            {
                distance = abs(current - queue[i]);

                if (distance < minDistance)
                {
                    minDistance = distance;
                    index = i;
                }
            }
        }

        visited[index] = 1;
        movement += abs(current - queue[index]);
        current = queue[index];

        printf("-> %d ", current);
    }

    printf("\nTotal Seek Time = %d\n", movement);
}

void scan(int queue[], int n, int head, int diskSize)
{
    int left[MAX], right[MAX];
    int l = 0, r = 0;
    int i, j, temp;
    int current = head;
    int movement = 0;

    for (i = 0; i < n; i++)
    {
        if (queue[i] < head)
            left[l++] = queue[i];
        else
            right[r++] = queue[i];
    }

    /* Sort left */
    for (i = 0; i < l - 1; i++)
        for (j = i + 1; j < l; j++)
            if (left[i] > left[j])
            {
                temp = left[i];
                left[i] = left[j];
                left[j] = temp;
            }

    /* Sort right */
    for (i = 0; i < r - 1; i++)
        for (j = i + 1; j < r; j++)
            if (right[i] > right[j])
            {
                temp = right[i];
                right[i] = right[j];
                right[j] = temp;
            }

    printf("\nSCAN Seek Sequence:\n");
    printf("%d ", head);

    /* Move right */
    for (i = 0; i < r; i++)
    {
        movement += abs(current - right[i]);
        current = right[i];
        printf("-> %d ", current);
    }

    /* Go to end of disk */
    if (current != diskSize - 1)
    {
        movement += abs(current - (diskSize - 1));
        current = diskSize - 1;
        printf("-> %d ", current);
    }

    /* Reverse direction */
    for (i = l - 1; i >= 0; i--)
    {
        movement += abs(current - left[i]);
        current = left[i];
        printf("-> %d ", current);
    }

    printf("\nTotal Seek Time = %d\n", movement);
}

int main()
{
    int queue[MAX];
    int n, head, diskSize;
    int i;

    printf("Enter disk size: ");
    scanf("%d", &diskSize);

    printf("Enter number of requests: ");
    scanf("%d", &n);

    printf("Enter request queue:\n");

    for (i = 0; i < n; i++)
        scanf("%d", &queue[i]);

    printf("Enter initial head position: ");
    scanf("%d", &head);

    printf("\n===== DISK SCHEDULING =====\n");

    fcfs(queue, n, head);
    sstf(queue, n, head);
    scan(queue, n, head, diskSize);

    return 0;
}
```

**Sample Input**

```text
Enter disk size: 200
Enter number of requests: 8
Enter request queue:
98 183 37 122 14 124 65 67
Enter initial head position: 53
```

The program displays:

```text
FCFS Seek Sequence:
53 -> 98 -> 183 -> 37 -> 122 -> 14 -> 124 -> 65 -> 67
Total Seek Time = ...

SSTF Seek Sequence:
53 -> 65 -> 67 -> 37 -> ...
Total Seek Time = ...

SCAN Seek Sequence:
53 -> 65 -> 67 -> 98 -> 122 -> 124 -> 183 -> 199 -> 37 -> ...
Total Seek Time = ...
```

**Note:** This SCAN implementation assumes the head initially moves toward the **right/end of the disk**.

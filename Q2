```c
#include <stdio.h>

#define MAX 1000

int bitmap[MAX];

void displayBitmap(int n)
{
    int i;

    printf("\nCurrent Bitmap:\n");

    for (i = 0; i < n; i++)
        printf("%d ", bitmap[i]);

    printf("\n");
}

void allocateBlocks(int n, int required)
{
    int i, count = 0;

    printf("\nAllocated Blocks: ");

    for (i = 0; i < n && count < required; i++)
    {
        if (bitmap[i] == 0)
        {
            bitmap[i] = 1;
            printf("%d ", i);
            count++;
        }
    }

    if (count < required)
    {
        printf("\nAllocation Failed!\n");
        printf("Insufficient free blocks.\n");

        /* Rollback */
        for (i = 0; i < n && count > 0; i++)
        {
            if (bitmap[i] == 1)
            {
                bitmap[i] = 0;
                count--;
            }
        }
    }
    else
    {
        printf("\nAllocation Successful.\n");
    }
}

void deallocateBlock(int block, int n)
{
    if (block < 0 || block >= n)
    {
        printf("Invalid block number: %d\n", block);
        return;
    }

    if (bitmap[block] == 0)
    {
        printf("Block %d is already free.\n", block);
    }
    else
    {
        bitmap[block] = 0;
        printf("Block %d deallocated successfully.\n", block);
    }
}

int main()
{
    int n, required;
    int i, deallocCount, block;

    printf("Enter total number of disk blocks: ");
    scanf("%d", &n);

    if (n <= 0 || n > MAX)
    {
        printf("Invalid disk size.\n");
        return 0;
    }

    printf("Enter initial bitmap:\n");

    for (i = 0; i < n; i++)
        scanf("%d", &bitmap[i]);

    printf("\nInitial Bitmap:");
    displayBitmap(n);

    printf("\nEnter number of blocks required for allocation: ");
    scanf("%d", &required);

    allocateBlocks(n, required);

    printf("\nBitmap after allocation:");
    displayBitmap(n);

    printf("\nEnter number of blocks to deallocate: ");
    scanf("%d", &deallocCount);

    for (i = 0; i < deallocCount; i++)
    {
        printf("Enter block number to deallocate: ");
        scanf("%d", &block);

        deallocateBlock(block, n);
    }

    printf("\nBitmap after deallocation:");
    displayBitmap(n);

    return 0;
}
```

**Sample Input**

```text
Enter total number of disk blocks: 10
Enter initial bitmap:
1 0 1 0 0 1 0 0 1 0

Enter number of blocks required for allocation: 3
```

**Sample Output**

```text
Allocated Blocks: 1 3 4
Allocation Successful.

Bitmap after allocation:
1 1 1 1 1 1 0 0 1 0
```

After deallocation:

```text
Enter block number to deallocate: 3

Bitmap after deallocation:
1 1 1 0 1 1 0 0 1 0
```
